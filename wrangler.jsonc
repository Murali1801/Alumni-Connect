{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Live at https://alumnibridge.in, also https://sjcem-alumni.muralidharacharya7.workers.dev
  "name": "sjcem-alumni",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's keepNames wraps functions in __name(); next-themes serialises its
  // theme script with toString(), so the inlined copy throws in the browser.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "alumnibridge.in", "custom_domain": true }]
  // Server-only secrets are set with `wrangler secret put`, never here:
  // SUPABASE_SERVICE_ROLE_KEY, OPENROUTER_API_KEY, CLOUDFLARE_TURN_KEY_ID,
  // CLOUDFLARE_TURN_API_TOKEN (or TURN_URL / TURN_USERNAME / TURN_CREDENTIAL).
}
